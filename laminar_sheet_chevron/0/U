FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 -0.5 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0 -0.5 0);
    }

    outlet
    {
        type    zeroGradient;
    }

    bottom
    {
        type            noSlip;
    }

    top
    {
        type            noSlip;
    }

    sides
    {
        type            noSlip;
    }

    sheet_chevron
    {
        type            noSlip;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

