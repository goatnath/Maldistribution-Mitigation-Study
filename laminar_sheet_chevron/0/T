FoamFile
{
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 298;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 298;
        value           uniform 298;
    }

    bottom
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    sides
    {
        type            zeroGradient;
    }

    sheet_chevron
    {
        type            zeroGradient;
    }

    #includeEtc "caseDicts/setConstraintTypes"
}

