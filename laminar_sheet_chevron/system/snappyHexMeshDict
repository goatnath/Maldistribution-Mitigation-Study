FoamFile
{
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false;

geometry
{
    sheet_chevron
    {
        type triSurfaceMesh;
        file "sheet_chevron.stl";
    }
}

castellatedMeshControls
{
    maxLocalCells 1000000;
    maxGlobalCells 2000000;
    minRefinementCells 10;
    maxLoadUnbalance 0.10;
    nCellsBetweenLevels 3;

    features
    (
    );

    refinementSurfaces
    {
        sheet_chevron
        {
            level (2 2);
            patchInfo
            {
                type wall;
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
    }

    locationInMesh (0.0 0.0 0.05);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
    }
    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    
    // Advanced settings
    featureAngle 60;
    slipFraction 0.5;
    nDepthIter 5;
    nMaxThicknessToMedialRatio 0.3;
    maxThicknessToMedialRatio 0.3;
    nSmoothThickness 10;
    nSmoothScale 4;
    nSmoothAlpha 5;
    filterSlipFraction 1.0;
    nMedialAxisIter 10;
}

meshLimitControls
{
    maxMetric 10.0;
}

meshQualityControls
{
    #includeEtc "caseDicts/mesh/generation/meshQualityDict"
}

writeFlags
(
    scalarLevels
    layerSets
    layerFields
);

mergeTolerance 1e-6;

